(footprint "INS-1"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Reflector INS-1 neon glow indicator, viewed axially through the end face of the bulb; 6.8 mm diameter glass envelope standing on two flexible wire leads that emerge together from the pinch seal. The leads are soft wire on no fixed pitch, so this land pattern sets it at 2.54 mm; 0.7 mm holes leave room to thread them. A is the anode, the small internal cylinder; the glow forms on K, the large cylinder. The envelope is cantilevered on the leads and wants lateral support from a bezel hole or a printed retainer wherever the assembly is handled")
	(tags "INS-1 neon glow discharge indicator lamp nixie clock colon separator dot THT")
