# KiCad .gitignore
# See: https://gitlab.com/kicad/code/kicad templates

# --- Auto-generated backups ---
*-backups/
*.bak

# --- FreeCAD rolling backups (cad/) ---
*.FCStd[0-9]*
*.FCBak

# --- Autosave / temporary scratch files ---
_autosave-*
\#auto_saved_files\#
*.000

# --- Lock files (created while KiCad has files open) ---
*.lck
~*.lck
*~

# --- Per-user local project state (window/display prefs, not design data) ---
*.kicad_prl

# --- Caches (regenerated automatically) ---
fp-info-cache
*-cache.lib
*.sch-bak

# --- Generated / fabrication outputs ---
# Uncomment or adjust to match where you export these.
production/
# make_release.py output; release artifacts are reproducible from the rev tags
fab/

# --- Claude Code personal settings (team settings live in .claude/settings.json) ---
.claude/settings.local.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db

*.pyc

# --- LaTeX build artifacts (docs/design_analysis/) ---
docs/design_analysis/**/*.aux
docs/design_analysis/**/*.log
docs/design_analysis/**/*.out
docs/design_analysis/**/*.toc
docs/design_analysis/**/*.lof
docs/design_analysis/**/*.lot
docs/design_analysis/**/*.fls
docs/design_analysis/**/*.fdb_latexmk
docs/design_analysis/**/*.synctex.gz
docs/design_analysis/**/*.bbl
docs/design_analysis/**/*.blg
docs/design_analysis/**/*.pdf
# ...but figures/ holds committed source artwork, not build output.
!docs/design_analysis/figures/*.pdf
